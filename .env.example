# ==============================================================================
# KEYQUIZ ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# --- FASTAPI BACKEND CONFIGURATION ---
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- SUPABASE CONFIGURATION ---
# Dapatkan dari Supabase Dashboard -> Project Settings -> API & Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL Connection String (Diperlukan untuk otomatisasi migrasi init_db.py)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- AI & LLM PROVIDER (GROQ / OPENAI) ---
# Dapatkan dari https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Model Configurations
NAMA_MODEL_VISION=llama-3.2-11b-vision-preview
NAMA_MODEL_LLM=llama-3.3-70b-versatile
NAMA_MODEL_EMBEDDING=all-MiniLM-L6-v2

# --- VECTOR DATABASE (CHROMADB) ---
CHROMA_DB_PATH=./chroma_db
